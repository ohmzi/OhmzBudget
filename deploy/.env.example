# Copy to .env in this folder and edit; docker compose reads it automatically.
#
# Hosts OhmzBudget answers to (hostGuard), comma-separated, with or without
# port. localhost and 127.0.0.1 always work. When this is set, every other
# Host is refused with 403 — add the public hostname before exposing the
# stack through the tunnel:
# OHMZBUDGET_ALLOWED_HOSTS=localhost,127.0.0.1,budget.example.com
#
# Default when unset: localhost,127.0.0.1
